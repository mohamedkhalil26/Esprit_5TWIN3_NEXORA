APP_NAME=SolarShare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fr
APP_TIMEZONE=Africa/Tunis
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=solarshare
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Envoi reel via Gmail SMTP (voir docs/CONFIGURATION_EMAIL_GMAIL.md) ---
# MAIL_USERNAME : adresse Gmail ; MAIL_PASSWORD : mot de passe d'application Google (16 caracteres).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_REQUIRE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=30

# --- Mailpit local : commenter le bloc Gmail ci-dessus et decommenter celui-ci ---
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_REQUIRE_TLS=false
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="demo@solarshare.test"
# MAIL_FROM_NAME="${APP_NAME}"
# MAIL_TIMEOUT=30

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_PREFERRED_FREE_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_FALLBACK_CANDIDATE=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_ALTERNATIVE_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_CONNECT_TIMEOUT=10
OPENROUTER_TIMEOUT=60
OPENROUTER_TOTAL_BUDGET=110
OPENROUTER_MAX_TOKENS=1800
OPENROUTER_JSON_MODE=true
OPENROUTER_RETRY_BASE_MS=120
OPENROUTER_RETRY_JITTER_MS=120
OPENROUTER_RATE_LIMIT_COOLDOWN=60
OPENROUTER_MAX_RATE_LIMIT_COOLDOWN=21600

